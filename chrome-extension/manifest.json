{
  "manifest_version": 3,
  "name": "网络学堂作业提醒",
  "description": "Tsinghua Web Learning homework deadline reminder",
  "version": "1.0.0",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "webNavigation",
    "notifications"
  ],
  "host_permissions": [
    "https://learn.tsinghua.edu.cn/*",
    "https://id.tsinghua.edu.cn/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://id.tsinghua.edu.cn/*"],
      "js": ["content/autofill.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
